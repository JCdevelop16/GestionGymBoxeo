<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence

https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="ClubBoxing" transaction-type="RESOURCE_LOCAL">
        <class>Entidades.AsistenciaEntreno</class>
        <class>Entidades.Boxeador</class>
        <class>Entidades.Competicion</class>
        <class>Entidades.Convocatoria</class>
        <class>Entidades.ConvocatoriaBoxeador</class>
        <class>Entidades.Entrenador</class>
        <class>Entidades.Entrenamiento</class>
        <class>Entidades.Notifiacion</class>
        <class>Entidades.Pago</class>
        <class>Entidades.ParticipacionCompe</class>
        <class>Entidades.Usuario</class>
        <class>Entidades.Sysdiagram</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost;databaseName=ClubBoxing;integratedSecurity=true;encrypt=false;trustServerCertificate=true"/>
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>